{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nut-shop",
  // The Cloudflare account comes from CLOUDFLARE_ACCOUNT_ID at deploy time (see README "Deploy").
  "compatibility_date": "2025-09-02",
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/server.ts",
  "workers_dev": false,
  "observability": { "enabled": true },
  // Static files also pass through the Worker so they carry X-Robots-Tag.
  "assets": { "binding": "ASSETS", "run_worker_first": true },
  // off | auditor-only | crawlers-only (default) | on. See README "Indexing".
  "vars": { "INDEXING": "crawlers-only" },
  // `wrangler deploy` prunes any custom domain missing from this list.
  "routes": [
    { "pattern": "nutshop.squirrelscan.com", "custom_domain": true },
    // squirrelscan/repo#4870: internal-only TLS fixture hosts. The cloud TLS probe answers these with a
    // mocked certificate for internal orgs only (expiring in 5 days, expired, hostname mismatch); the
    // real certificate here is a normal valid one. Same site content, no redirect to the main host.
    { "pattern": "tls-expiring-5d.nutshop.squirrelscan.com", "custom_domain": true },
    { "pattern": "tls-expired.nutshop.squirrelscan.com", "custom_domain": true },
    { "pattern": "tls-mismatch.nutshop.squirrelscan.com", "custom_domain": true }
  ]
}
